;;; Commentary:

;; Grafana Light, derived from the Grafana Labs brand palette.  Every syntax
;; token clears WCAG AA (4.5:1) against the background, and comments are
;; kept clear of the threshold so they read as prose rather than as noise.
;;
;; Generated by tools/generate.py from palette.toml. Do not edit.
;; This is not an official Grafana Labs project.

;;; Code:

(deftheme grafana-light
  "Grafana Light, a dim color scheme from the Grafana Labs brand palette.")

(let ((class '((class color) (min-colors 89)))
      (crust       "#e4e4e4")
      (mantle      "#f0f0f0")
      (base        "#f7f7f7")
      (surface0    "#ececec")
      (surface1    "#dcdcdc")
      (surface2    "#c9c9c9")
      (bright      "#171717")
      (fg          "#3a3a3a")
      (subtext     "#5e5e5e")
      (faint       "#6a6a6a")
      (orange      "#c72f07")
      (amber       "#915d14")
      (yellow      "#6f681c")
      (green       "#0b7347")
      (light-green "#084b31")
      (light-blue  "#25708a")
      (blue        "#1540e0")
      (indigo      "#5240b8")
      (purple      "#9d1ab1")
      (pink        "#a93c68"))

  (custom-theme-set-faces
   'grafana-light

   `(default ((,class (:foreground ,fg :background ,base))))
   `(cursor ((,class (:background ,orange))))
   `(region ((,class (:background ,surface1 :distant-foreground ,bright :extend t))))
   `(highlight ((,class (:background ,surface1))))
   `(hl-line ((,class (:background ,surface0 :extend t))))
   `(fringe ((,class (:foreground ,faint :background ,base))))
   `(vertical-border ((,class (:foreground ,surface1))))
   `(window-divider ((,class (:foreground ,surface1))))
   `(window-divider-first-pixel ((,class (:foreground ,surface1))))
   `(window-divider-last-pixel ((,class (:foreground ,surface1))))
   `(minibuffer-prompt ((,class (:foreground ,orange :weight bold))))
   `(shadow ((,class (:foreground ,faint))))
   `(link ((,class (:foreground ,light-blue :underline t))))
   `(link-visited ((,class (:foreground ,purple :underline t))))
   `(error ((,class (:foreground ,pink :weight bold))))
   `(warning ((,class (:foreground ,amber :weight bold))))
   `(success ((,class (:foreground ,green :weight bold))))
   `(escape-glyph ((,class (:foreground ,amber))))
   `(homoglyph ((,class (:foreground ,amber))))
   `(nobreak-space ((,class (:foreground ,faint :underline t))))
   `(nobreak-hyphen ((,class (:foreground ,faint))))
   `(trailing-whitespace ((,class (:background ,pink))))
   `(whitespace-trailing ((,class (:background ,pink :foreground ,base))))
   `(whitespace-tab ((,class (:foreground ,surface2 :background ,base))))
   `(whitespace-space ((,class (:foreground ,surface2 :background ,base))))
   `(whitespace-line ((,class (:background ,surface0))))
   `(secondary-selection ((,class (:background ,surface0 :extend t))))
   `(match ((,class (:background ,purple :foreground ,base))))
   `(isearch ((,class (:background ,orange :foreground ,base :weight bold))))
   `(isearch-fail ((,class (:background ,pink :foreground ,base))))
   `(lazy-highlight ((,class (:background ,surface1 :foreground ,orange))))
   `(show-paren-match ((,class (:foreground ,purple :background ,surface1 :weight bold))))
   `(show-paren-mismatch ((,class (:foreground ,bright :background ,pink :weight bold))))
   `(tooltip ((,class (:foreground ,fg :background ,mantle))))
   `(help-key-binding ((,class (:foreground ,amber :background ,surface0))))
   `(line-number ((,class (:foreground ,faint :background ,base))))
   `(line-number-current-line ((,class (:foreground ,fg :background ,surface0 :weight bold))))
   `(mode-line ((,class (:foreground ,fg :background ,surface0 :box nil))))
   `(mode-line-inactive ((,class (:foreground ,faint :background ,mantle :box nil))))
   `(mode-line-buffer-id ((,class (:foreground ,orange :weight bold))))
   `(mode-line-highlight ((,class (:foreground ,purple))))
   `(mode-line-emphasis ((,class (:foreground ,orange :weight bold))))
   `(header-line ((,class (:foreground ,fg :background ,mantle))))
   `(tab-bar ((,class (:foreground ,faint :background ,mantle))))
   `(tab-bar-tab ((,class (:foreground ,bright :background ,base :weight bold))))
   `(tab-bar-tab-inactive ((,class (:foreground ,faint :background ,mantle))))
   `(tab-line ((,class (:foreground ,faint :background ,mantle))))
   `(font-lock-builtin-face ((,class (:foreground ,amber))))
   `(font-lock-comment-face ((,class (:foreground ,subtext :slant italic))))
   `(font-lock-comment-delimiter-face ((,class (:foreground ,subtext :slant italic))))
   `(font-lock-doc-face ((,class (:foreground ,subtext :slant italic))))
   `(font-lock-doc-markup-face ((,class (:foreground ,light-green))))
   `(font-lock-constant-face ((,class (:foreground ,light-blue))))
   `(font-lock-function-name-face ((,class (:foreground ,purple))))
   `(font-lock-function-call-face ((,class (:foreground ,purple))))
   `(font-lock-keyword-face ((,class (:foreground ,orange))))
   `(font-lock-negation-char-face ((,class (:foreground ,orange))))
   `(font-lock-number-face ((,class (:foreground ,light-blue))))
   `(font-lock-operator-face ((,class (:foreground ,orange))))
   `(font-lock-preprocessor-face ((,class (:foreground ,indigo))))
   `(font-lock-property-name-face ((,class (:foreground ,light-green))))
   `(font-lock-property-use-face ((,class (:foreground ,light-green))))
   `(font-lock-punctuation-face ((,class (:foreground ,subtext))))
   `(font-lock-bracket-face ((,class (:foreground ,subtext))))
   `(font-lock-delimiter-face ((,class (:foreground ,subtext))))
   `(font-lock-escape-face ((,class (:foreground ,amber))))
   `(font-lock-regexp-face ((,class (:foreground ,pink))))
   `(font-lock-regexp-grouping-backslash ((,class (:foreground ,amber))))
   `(font-lock-regexp-grouping-construct ((,class (:foreground ,pink))))
   `(font-lock-string-face ((,class (:foreground ,green))))
   `(font-lock-type-face ((,class (:foreground ,blue))))
   `(font-lock-variable-name-face ((,class (:foreground ,fg))))
   `(font-lock-variable-use-face ((,class (:foreground ,fg))))
   `(font-lock-warning-face ((,class (:foreground ,amber :weight bold))))
   `(font-lock-misc-punctuation-face ((,class (:foreground ,subtext))))
   `(diff-added ((,class (:foreground ,green :extend t))))
   `(diff-removed ((,class (:foreground ,pink :extend t))))
   `(diff-changed ((,class (:foreground ,yellow :extend t))))
   `(diff-indicator-added ((,class (:foreground ,green))))
   `(diff-indicator-removed ((,class (:foreground ,pink))))
   `(diff-header ((,class (:foreground ,fg :background ,mantle :extend t))))
   `(diff-file-header ((,class (:foreground ,bright :weight bold :extend t))))
   `(diff-hunk-header ((,class (:foreground ,orange :background ,mantle :extend t))))
   `(diff-refine-added ((,class (:foreground ,base :background ,green))))
   `(diff-refine-removed ((,class (:foreground ,base :background ,pink))))
   `(completions-common-part ((,class (:foreground ,orange :weight bold))))
   `(completions-first-difference ((,class (:foreground ,purple))))
   `(completions-annotations ((,class (:foreground ,subtext :slant italic))))
   `(dired-directory ((,class (:foreground ,blue :weight bold))))
   `(dired-symlink ((,class (:foreground ,purple))))
   `(dired-header ((,class (:foreground ,orange :weight bold))))
   `(dired-ignored ((,class (:foreground ,faint))))
   `(flymake-error ((,class (:underline (:style wave :color ,pink)))))
   `(flymake-warning ((,class (:underline (:style wave :color ,amber)))))
   `(flymake-note ((,class (:underline (:style wave :color ,blue)))))
   `(compilation-error ((,class (:foreground ,pink :weight bold))))
   `(compilation-warning ((,class (:foreground ,amber))))
   `(compilation-info ((,class (:foreground ,blue))))
   `(compilation-mode-line-fail ((,class (:foreground ,pink))))
   `(compilation-mode-line-run ((,class (:foreground ,amber))))
   `(compilation-mode-line-exit ((,class (:foreground ,green))))
   `(org-level-1 ((,class (:foreground ,orange :weight bold))))
   `(org-level-2 ((,class (:foreground ,purple :weight bold))))
   `(org-level-3 ((,class (:foreground ,blue :weight bold))))
   `(org-level-4 ((,class (:foreground ,green :weight bold))))
   `(org-level-5 ((,class (:foreground ,light-blue))))
   `(org-level-6 ((,class (:foreground ,indigo))))
   `(org-document-title ((,class (:foreground ,bright :weight bold))))
   `(org-block ((,class (:background ,mantle :extend t))))
   `(org-block-begin-line ((,class (:foreground ,faint :background ,mantle :extend t))))
   `(org-block-end-line ((,class (:foreground ,faint :background ,mantle :extend t))))
   `(org-code ((,class (:foreground ,green))))
   `(org-verbatim ((,class (:foreground ,green))))
   `(org-table ((,class (:foreground ,blue))))
   `(org-link ((,class (:foreground ,light-blue :underline t))))
   `(org-todo ((,class (:foreground ,pink :weight bold))))
   `(org-done ((,class (:foreground ,green :weight bold))))
   `(org-headline-done ((,class (:foreground ,faint))))
   `(org-date ((,class (:foreground ,light-blue :underline t))))
   `(org-special-keyword ((,class (:foreground ,orange))))
   `(org-checkbox ((,class (:foreground ,orange :weight bold))))
   `(org-agenda-date ((,class (:foreground ,blue))))
   `(org-agenda-done ((,class (:foreground ,green))))
   `(org-scheduled ((,class (:foreground ,green))))
   `(org-warning ((,class (:foreground ,amber :weight bold))))
   `(markdown-header-face ((,class (:foreground ,orange :weight bold))))
   `(markdown-code-face ((,class (:foreground ,green :background ,mantle))))
   `(markdown-inline-code-face ((,class (:foreground ,green))))
   `(markdown-link-face ((,class (:foreground ,light-blue))))
   `(markdown-url-face ((,class (:foreground ,light-blue :underline t))))
   `(markdown-blockquote-face ((,class (:foreground ,subtext :slant italic))))
   `(markdown-list-face ((,class (:foreground ,orange))))
   `(term-color-black ((,class (:foreground ,surface1 :background ,surface1))))
   `(term-color-red ((,class (:foreground ,pink :background ,pink))))
   `(term-color-green ((,class (:foreground ,green :background ,green))))
   `(term-color-yellow ((,class (:foreground ,amber :background ,amber))))
   `(term-color-blue ((,class (:foreground ,blue :background ,blue))))
   `(term-color-magenta ((,class (:foreground ,purple :background ,purple))))
   `(term-color-cyan ((,class (:foreground ,light-blue :background ,light-blue))))
   `(term-color-white ((,class (:foreground ,fg :background ,fg)))))

  (custom-theme-set-variables
   'grafana-light
   `(ansi-color-names-vector ["#171717" "#a93c68" "#0b7347" "#915d14" "#1540e0" "#9d1ab1" "#25708a" "#dcdcdc"])))

;;;###autoload
(when (and (boundp 'custom-theme-load-path) load-file-name)
  (add-to-list 'custom-theme-load-path
               (file-name-as-directory (file-name-directory load-file-name))))

(provide-theme 'grafana-light)

