" grafana-dark-dim.vim -- Grafana Dark Dim
" Generated by tools/generate.py from palette.toml. Do not edit.
" https://github.com/ymotongpoo/grafana-color-scheme
" SPDX-License-Identifier: Apache-2.0
"
" Truecolor is not enabled here on purpose. Add to your own config:
"   set termguicolors
" and inside tmux (3.2+):
"   set -as terminal-features ",*:RGB"

highlight clear
if exists('syntax_on')
  syntax reset
endif

