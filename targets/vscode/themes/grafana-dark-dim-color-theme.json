    "property.readonly": "#ca7cdb",
    "enumMember": "#ca7cdb",
    "decorator": "#dbaa6d",
    "event": "#78bad0",
    "function": "#6794e8",
    "function.defaultLibrary": "#dbaa6d",
    "method": "#6794e8",
