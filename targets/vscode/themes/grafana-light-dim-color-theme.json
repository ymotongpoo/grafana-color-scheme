    "string": "#4c856b",
    "keyword": "#c05f46",
    "number": "#ac5fbc",
    "regexp": "#b65f7e",
    "operator": "#c05f46",
    "*.deprecated": {
      "strikethrough": true
    },
    "*.declaration": {
      "bold": true
    }
  }
}
