  "semanticTokenColors": {
    "namespace": "#ffed23",
    "class": "#ffed23",
    "enum": "#ffed23",
    "interface": "#ffed23",
    "struct": "#ffed23",
    "typeParameter": "#ffed23",
    "type": "#ffed23",
    "parameter": "#f4f4f4",
    "variable": "#f4f4f4",
    "variable.readonly": "#d444f1",
    "variable.defaultLibrary": "#ffab29",
    "property": "#3fc6eb",
    "property.readonly": "#d444f1",
    "enumMember": "#d444f1",
    "decorator": "#ffab29",
    "event": "#3fc6eb",
    "function": "#2970ff",
    "function.defaultLibrary": "#ffab29",
    "method": "#2970ff",
    "macro": "#7d64ff",
    "label": "#ffab29",
    "comment": {
      "foreground": "#afafaf",
      "italic": true
    },
    "string": "#04bc4c",
    "keyword": "#ff671d",
    "number": "#d444f1",
    "regexp": "#f35998",
    "operator": "#ff671d",
    "*.deprecated": {
      "strikethrough": true
    },
    "*.declaration": {
      "bold": true
    }
