      "italic": true
    },
    "string": "#89a17e",
    "keyword": "#c18c68",
    "number": "#789fa6",
    "regexp": "#b77f94",
    "operator": "#c18c68",
    "*.deprecated": {
      "strikethrough": true
    },
    "*.declaration": {
      "bold": true
    }
  }
}
