{
  "schemaVersion": 1,
  "base": "light",
  "tokens": {
    "--background": "#f4f4f4",
    "--foreground": "#3a3a3a",
    "--editor-surface": "#f4f4f4",
    "--card": "#eaeaea",
    "--popover": "#eaeaea",
    "--primary": "#c05f46",
    "--primary-foreground": "#000000",
    "--muted": "#ececec",
    "--muted-foreground": "#616161",
    "--accent": "#dedede",
    "--border": "#cfcfcf",
    "--ring": "#c05f46",
    "--sidebar": "#ececec",
    "--worktree-sidebar": "#e2e2e2",
    "--worktree-sidebar-active": "#dedede",
    "--tab-bar": "#ececec",
    "--tab-active": "#f4f4f4",
    "--tab-inactive": "#ececec",
    "--tab-active-indicator": "#c05f46",
    "--chat-user-message": "#dedede",
    "--chat-muted-foreground": "#616161",
    "--chat-inline-code": "#dedede",
    "--chat-inline-code-foreground": "#3a3a3a",
    "--chat-code-block": "#eaeaea",
    "--text-link": "#487280",
    "--editor-selection": "#4b76c744",
    "--diff-added": "#487661",
    "--diff-removed": "#9d5870",
    "--git-decoration-added": "#4c856b",
    "--git-decoration-modified": "#947347",
    "--git-decoration-deleted": "#b65f7e",
    "--diff-added-background": "#4c856b14"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6e6e6e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comment doc",
      "scope": [
        "comment.block.documentation",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#6e6e6e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#4c856b"
      }
    },
    {
      "name": "String escape",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#ad7548"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#b65f7e"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ac5fbc"
      }
    },
    {
      "name": "Boolean and language constant",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null"
      ],
      "settings": {
        "foreground": "#ac5fbc"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant.other",
        "variable.other.constant",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#ac5fbc"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.other",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#c05f46"
      }
    },
    {
      "name": "Keyword control",
      "scope": [
        "keyword.control",
        "keyword.control.flow"
      ],
      "settings": {
        "foreground": "#c05f46"
      }
    },
    {
      "name": "Storage type",
      "scope": [
        "storage.type",
        "keyword.declaration"
      ],
      "settings": {
        "foreground": "#c05f46"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#c05f46"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.parameters",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#6e6e6e"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "support.type",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#947347"
      }
    },
    {
      "name": "Class",
      "scope": [
        "entity.name.class",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#947347"
      }
    },
    {
      "name": "Interface",
      "scope": [
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#947347"
      }
    },
    {
      "name": "Namespace",
      "scope": [
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#947347"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#4b76c7"
      }
    },
    {
      "name": "Method",
      "scope": [
        "entity.name.function.member",
        "meta.function-call.method"
      ],
      "settings": {
        "foreground": "#4b76c7"
      }
    },
    {
      "name": "Builtin",
      "scope": [
        "support.function.builtin",
        "support.type.builtin",
        "variable.language"
      ],
      "settings": {
        "foreground": "#ad7548"
      }
    },
    {
      "name": "Decorator",
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#ad7548"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#3a3a3a"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#3a3a3a"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#4c8597"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#c05f46"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#ad7548"
      }
    },
    {
      "name": "Label",
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#ad7548"
      }
    },
    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#756ec6"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#b65f7e"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markup heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#c05f46",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#4c8597",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup code",
      "scope": [
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#4c856b"
      }
    },
    {
      "name": "Markup list",
      "scope": [
        "markup.list",
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#c05f46"
      }
    },
    {
      "name": "Markup quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#6e6e6e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#4c856b"
      }
    },
    {
      "name": "Markup deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#b65f7e"
      }
    },
    {
      "name": "Markup changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#947347"
      }
    },
    {
      "name": "JSON key",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#4c8597"
      }
    },
    {
      "name": "YAML key",
      "scope": [
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#4c8597"
      }
    },
    {
      "name": "CSS selector",
      "scope": [
        "entity.name.selector",
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#947347"
      }
    },
    {
      "name": "CSS property",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#4c8597"
      }
    },
    {
      "name": "Shell prompt",
      "scope": [
        "punctuation.definition.prompt"
      ],
      "settings": {
        "foreground": "#c05f46"
      }
    }
  ]
}
